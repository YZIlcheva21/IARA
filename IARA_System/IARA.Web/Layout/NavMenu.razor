@using IARA.Web.Services

<div class="top-row ps-3 navbar navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand font-weight-bold" href="/">ИАРА СИСТЕМА</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Табло
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ships">
                <span class="oi oi-ship" aria-hidden="true"></span> Регистър Кораби
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="licenses">
                <span class="oi oi-document" aria-hidden="true"></span> Разрешителни
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="add-catch">
                <span class="oi oi-plus" aria-hidden="true"></span> Нов Улов
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reports">
                <span class="oi oi-bar-chart" aria-hidden="true"></span> Справки
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="my-catches">
                <span class="oi oi-fish" aria-hidden="true"></span> Моите Уловове
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="inspections">
                <span class="oi oi-clipboard" aria-hidden="true"></span> Инспекции
            </NavLink>
        </div>
        <div class="nav-item px-3 mt-5">
            <button class="nav-link btn btn-link text-start w-100 p-2 text-white border-0" @onclick="HandleLogout">
                <span class="oi oi-account-logout" aria-hidden="true"></span> Изход
            </button>
        </div>
    </nav>
</div>

@code {
    [Inject]
    private AuthService AuthService { get; set; } = default!;
    
    [Inject] 
    public NavigationManager NavManager { get; set; }
    
    private async Task HandleLogout()
    {
        // Clear authentication token
        await AuthService.LogoutAsync();
        // Redirect to login - user should ONLY see login/register after logout
        NavManager.NavigateTo("/login", forceLoad: true);
    }
}