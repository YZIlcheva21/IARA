@page "/add-catch"
@using System.Net.Http.Json
@using IARA.Web.Services
@inject AuthenticatedHttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject AuthService AuthService

@if (!authChecked)
{
    @* DO NOT RENDER ANYTHING until auth is checked *@
    <div style="display: none;"></div>
}
else if (!isAuthenticated)
{
    @* NOT AUTHENTICATED - redirect will happen *@
    <div style="display: none;"></div>
}
else
{
<div class="container py-5 page-container">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <div class="mb-3">
                    <div style="font-size: 4rem; margin-bottom: 1rem;">🎣</div>
                </div>
                <h2 class="text-center text-primary mb-2 fw-bold" style="font-size: 2rem; letter-spacing: 0.5px;">Нов Улов</h2>
                <p class="text-muted mb-0" style="font-size: 0.95rem;">Регистрация на нов любителски улов</p>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
            <div class="alert alert-danger">@errorMessage</div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
            <div class="alert alert-success">@successMessage</div>
            }
            <EditForm Model="@catchModel" OnValidSubmit="HandleSubmit">
                <div class="mb-3">
                    <label class="form-label fw-bold">Вид Риба</label>
                    @* 👇 ПРОМЯНА 1: FishSpecies *@
                    <InputSelect @bind-Value="catchModel.FishSpecies" class="form-select p-3">
                        <option value="">Изберете вид...</option>
                        <option value="Шаран">Шаран</option>
                        <option value="Скумрия">Скумрия</option>
                        <option value="Калкан">Калкан</option>
                        <option value="Пъстърва">Пъстърва</option>
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Тегло (кг) *</label>
                    @* 👇 ПРОМЯНА 2: WeightKgs *@
                    <InputNumber @bind-Value="catchModel.WeightKgs" class="form-control p-3" placeholder="0.00" min="0.01" step="0.01" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Място на улов</label>
                    @* 👇 ПРОМЯНА 3: FishingLocation *@
                    <InputText @bind-Value="catchModel.FishingLocation" class="form-control p-3" placeholder="Напр. Черно море - Варна" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Метод на улов</label>
                    @* 👇 ПРОМЯНА 4: FishingMethod *@
                    <InputText @bind-Value="catchModel.FishingMethod" class="form-control p-3" placeholder="Напр. Въдица, Мрежа" />
                </div>
                <button type="submit" class="btn btn-primary w-100 p-3 fw-bold rounded-pill" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    ЗАПИШИ
                </button>
                <div class="mt-3 text-center">
                    <a href="/my-catches" class="text-primary">Преглед на моите уловове</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>
}

@code {
    private bool authChecked = false;
    private bool isAuthenticated = false;
    private CatchModel catchModel = new();
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        var token = await AuthService.GetTokenAsync();
        isAuthenticated = !string.IsNullOrEmpty(token) && !string.IsNullOrWhiteSpace(token);
        
        if (!isAuthenticated)
        {
            authChecked = true;
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }
        
        authChecked = true;
    }

    private async Task HandleSubmit() {
        try {
            isSubmitting = true;
            errorMessage = null;
            successMessage = null;

            // Валидация с новите имена
            if (string.IsNullOrWhiteSpace(catchModel.FishSpecies))
            {
                errorMessage = "Моля изберете вид риба!";
                return;
            }

            if (catchModel.WeightKgs <= 0)
            {
                errorMessage = "Теглото трябва да бъде по-голямо от 0!";
                return;
            }

            // Вече пращаме директно модела, защото имената съвпадат с API-то
            var response = await Http.PostAsJsonAsync("api/AmateurCatches", catchModel);
            
            if (response.IsSuccessStatusCode) {
                successMessage = "Успешно записан улов!";
                catchModel = new CatchModel();
                StateHasChanged(); // Обновяваме UI веднага
                await Task.Delay(2000);
                successMessage = null;
            } else {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Грешка: {response.StatusCode} - {errorContent}";
            }
        } catch (Exception ex) {
            errorMessage = ex.Message.Contains("Failed to fetch") 
                ? "API сървърът не е достъпен." 
                : $"Грешка: {ex.Message}";
        } finally {
            isSubmitting = false;
        }
    }

    // Класът е обновен да съвпада с IARA.Domain
    public class CatchModel 
    { 
        public string FishSpecies { get; set; } = ""; // Беше FishType
        public decimal? WeightKgs { get; set; }       // Беше Weight (double -> decimal?)
        public string? FishingLocation { get; set; }  // Беше Location
        public string? FishingMethod { get; set; }    // Беше Method
    }
}