{
<div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">Редактиране на инспекция</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseEditInspectionModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@editInspectionModel" OnValidSubmit="@(() => HandleUpdateInspection(editInspectionId))">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ID на инспектор *</label>
                            <InputNumber @bind-Value="editInspectionModel.InspectorId" class="form-control" />
                            <ValidationMessage For="@(() => editInspectionModel.InspectorId)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ID на кораб</label>
                            <InputNumber @bind-Value="editInspectionModel.ShipId" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Дата на инспекция *</label>
                            <InputDate @bind-Value="editInspectionModel.InspectionDate" class="form-control" />
                            <ValidationMessage For="@(() => editInspectionModel.InspectionDate)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Тип инспекция *</label>
                            <InputText @bind-Value="editInspectionModel.InspectionType" class="form-control" />
                            <ValidationMessage For="@(() => editInspectionModel.InspectionType)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Статус *</label>
                            <InputSelect @bind-Value="editInspectionModel.Status" class="form-select">
                                <option value="">Изберете...</option>
                                <option value="Completed">Завършена</option>
                                <option value="Pending">Изчакваща</option>
                                <option value="Violation">Нарушение</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => editInspectionModel.Status)" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">Намерения</label>
                            <InputTextArea @bind-Value="editInspectionModel.Findings" class="form-control" rows="3" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">Нарушения</label>
                            <InputTextArea @bind-Value="editInspectionModel.Violations" class="form-control" rows="3" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEditInspectionModal">Отказ</button>
                        <button type="submit" class="btn btn-primary" disabled="@isUpdatingInspection">
                            @if (isUpdatingInspection)
                            {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Запази
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
}
}

@code {
    private InspectionDto[]? inspections;
    private bool isLoading = false;
    private bool authChecked = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private DateTime? fromDate;
    private DateTime? toDate;
    private string? statusFilter = "";

    private bool showAddInspectionModal = false;
    private bool isAddingInspection = false;
    private string? addInspectionErrorMessage;
    private CreateInspectionModel newInspection = new();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication BEFORE rendering ANYTHING
        var token = await AuthService.GetTokenAsync();
        isAuthenticated = !string.IsNullOrEmpty(token) && !string.IsNullOrWhiteSpace(token);
        
        if (!isAuthenticated)
        {
            // NOT authenticated - redirect to login IMMEDIATELY
            authChecked = true;
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }
        
        // Authenticated - allow rendering
        authChecked = true;
        await LoadInspections();
    }

    private async Task LoadInspections()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var queryParams = new List<string>();
            if (fromDate.HasValue)
                queryParams.Add($"fromDate={fromDate.Value:yyyy-MM-dd}");
            if (toDate.HasValue)
                queryParams.Add($"toDate={toDate.Value:yyyy-MM-dd}");
            if (!string.IsNullOrEmpty(statusFilter))
                queryParams.Add($"status={statusFilter}");

            var url = "api/Inspections";
            if (queryParams.Any())
                url += "?" + string.Join("&", queryParams);

            inspections = await Http.GetFromJsonAsync<InspectionDto[]>(url);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message.Contains("Failed to fetch") 
                ? "API сървърът не е достъпен. Моля стартирайте IARA.API проекта първо!"
                : $"Грешка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddInspectionModal()
    {
        showAddInspectionModal = true;
        // Example inspection data
        newInspection = new CreateInspectionModel
        {
            InspectorId = 1, // Example inspector ID
            InspectionDate = DateTime.Today,
            InspectionType = "Рутенна проверка",
            Location = "Пристанище Варна",
            Status = "Completed",
            Findings = "Всички документи са наред. Разрешителното е валидно.",
            Notes = "Проверка извършена успешно без нарушения."
        };
        addInspectionErrorMessage = null;
    }

    private void CloseAddInspectionModal()
    {
        showAddInspectionModal = false;
        newInspection = new CreateInspectionModel();
        addInspectionErrorMessage = null;
    }

    private async Task HandleAddInspection()
    {
        try
        {
            isAddingInspection = true;
            addInspectionErrorMessage = null;

            var response = await Http.PostAsJsonAsync("api/Inspections", newInspection);
            if (response.IsSuccessStatusCode)
            {
                CloseAddInspectionModal();
                await LoadInspections();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    addInspectionErrorMessage = "Нямате права за създаване на инспекции. Трябва да сте Admin или Inspector!";
                }
                else
                {
                    addInspectionErrorMessage = $"Грешка: {response.StatusCode} - {errorContent}";
                }
                isAddingInspection = false;
            }
        }
        catch (Exception ex)
        {
            addInspectionErrorMessage = $"Грешка: {ex.Message}";
            isAddingInspection = false;
        }
    }

    private async Task DeleteInspection(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Сигурни ли сте, че искате да изтриете инспекция #{id}?"))
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/Inspections/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadInspections();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Грешка при изтриване: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Грешка: {ex.Message}");
        }
    }

    private bool showViewInspectionModal = false;
    private InspectionDto? currentInspection;

    private async Task ViewInspection(int id)
    {
        try
        {
            var inspection = await Http.GetFromJsonAsync<InspectionDto>($"api/Inspections/{id}");
            if (inspection != null)
            {
                currentInspection = inspection;
                showViewInspectionModal = true;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Инспекцията не е намерена!");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Грешка при зареждане: {ex.Message}");
        }
    }

    private void CloseViewInspectionModal()
    {
        showViewInspectionModal = false;
        currentInspection = null;
    }

    private bool showEditInspectionModal = false;
    private CreateInspectionModel? editInspectionModel;
    private int editInspectionId = 0;
    private bool isUpdatingInspection = false;

    private async Task EditInspection(int id)
    {
        try
        {
            var inspection = await Http.GetFromJsonAsync<InspectionDto>($"api/Inspections/{id}");
            if (inspection != null)
            {
                editInspectionModel = new CreateInspectionModel
                {
                    InspectorId = inspection.InspectorId,
                    ShipId = inspection.ShipId,
                    LicenseId = inspection.LicenseId,
                    InspectionDate = inspection.InspectionDate,
                    InspectionType = inspection.InspectionType ?? "",
                    Location = inspection.Location,
                    Findings = inspection.Findings,
                    Violations = inspection.Violations,
                    ActionsTaken = inspection.ActionsTaken,
                    Status = inspection.Status ?? "",
                    Notes = inspection.Notes
                };
                editInspectionId = id;
                showEditInspectionModal = true;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Инспекцията не е намерена!");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Грешка при зареждане: {ex.Message}");
        }
    }

    private void CloseEditInspectionModal()
    {
        showEditInspectionModal = false;
        editInspectionModel = null;
        editInspectionId = 0;
        isUpdatingInspection = false;
    }

    private void HandleInvalidUpdateSubmit()
    {
        // Validation errors will be shown by ValidationMessage components
    }

    private async Task HandleUpdateInspection(int id)
    {
        if (editInspectionModel == null) return;

        try
        {
            isUpdatingInspection = true;
            var updateDto = new InspectionDto
            {
                Id = id,
                InspectorId = editInspectionModel.InspectorId,
                ShipId = editInspectionModel.ShipId,
                LicenseId = editInspectionModel.LicenseId,
                InspectionDate = editInspectionModel.InspectionDate!.Value,
                InspectionType = editInspectionModel.InspectionType,
                Location = editInspectionModel.Location,
                Findings = editInspectionModel.Findings,
                Violations = editInspectionModel.Violations,
                ActionsTaken = editInspectionModel.ActionsTaken,
                Status = editInspectionModel.Status,
                Notes = editInspectionModel.Notes
            };

            var response = await Http.PutAsJsonAsync($"api/Inspections/{id}", updateDto);
            if (response.IsSuccessStatusCode)
            {
                CloseEditInspectionModal();
                await LoadInspections();
                await JS.InvokeVoidAsync("alert", "Инспекцията е обновена успешно!");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    await JS.InvokeVoidAsync("alert", "Нямате права за редактиране на инспекции. Трябва да сте Admin или Inspector!");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", $"Грешка: {response.StatusCode} - {errorContent}");
                }
                isUpdatingInspection = false;
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Грешка: {ex.Message}");
            isUpdatingInspection = false;
        }
    }

    public class InspectionDto
    {
        public int Id { get; set; }
        public int InspectorId { get; set; }
        public int? ShipId { get; set; }
        public int? LicenseId { get; set; }
        public DateTime InspectionDate { get; set; }
        public string? InspectionType { get; set; }
        public string? Location { get; set; }
        public string? Findings { get; set; }
        public string? Violations { get; set; }
        public string? ActionsTaken { get; set; }
        public string? Status { get; set; }
        public string? Notes { get; set; }
        public string? InspectorName { get; set; }
        public string? ShipName { get; set; }
        public string? LicenseNumber { get; set; }
    }

    public class CreateInspectionModel
    {
        [Required(ErrorMessage = "ID на инспектор е задължително")]
        public int InspectorId { get; set; }
        public int? ShipId { get; set; }
        public int? LicenseId { get; set; }
        [Required(ErrorMessage = "Дата на инспекция е задължителна")]
        public DateTime? InspectionDate { get; set; } = DateTime.Today;
        [Required(ErrorMessage = "Тип инспекция е задължителен")]
        public string InspectionType { get; set; } = "";
        public string? Location { get; set; }
        public string? Findings { get; set; }
        public string? Violations { get; set; }
        public string? ActionsTaken { get; set; }
        [Required(ErrorMessage = "Статус е задължителен")]
        public string Status { get; set; } = "";
        public string? Notes { get; set; }
    }
}
