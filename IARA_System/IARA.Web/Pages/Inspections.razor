@page "/inspections"
@using System.Net.Http.Json
@using System.Linq
@using System.ComponentModel.DataAnnotations
@using IARA.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject AuthenticatedHttpClient Http
@inject NavigationManager NavManager
@inject AuthService AuthService
@inject IJSRuntime JS

<PageTitle>Инспекции - ИАРА</PageTitle>

@if (!authChecked)
{
    @* DO NOT RENDER ANYTHING until auth is checked *@
    <div style="display: none;"></div>
}
else if (!isAuthenticated)
{
    @* NOT AUTHENTICATED - redirect will happen *@
    <div style="display: none;"></div>
}
else
{
<div class="container-fluid p-4">
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="page-title mb-2">
                    <span class="page-icon">🔍</span>
                    Инспекции
                </h1>
                <p class="page-subtitle text-muted mb-0">Управление и регистрация на инспекции</p>
            </div>
            <button class="btn btn-primary rounded-pill px-4 btn-add-action" @onclick="ShowAddInspectionModal">
                <span class="oi oi-plus me-2"></span>Нова Инспекция
            </button>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label class="form-label">От дата:</label>
            <InputDate @bind-Value="fromDate" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">До дата:</label>
            <InputDate @bind-Value="toDate" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Статус:</label>
            <InputSelect @bind-Value="statusFilter" class="form-select">
                <option value="">Всички</option>
                <option value="Completed">Завършена</option>
                <option value="Pending">Изчакваща</option>
                <option value="Violation">Нарушение</option>
            </InputSelect>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-secondary w-100" @onclick="LoadInspections">Филтрирай</button>
        </div>
    </div>

    @if (isLoading)
    {
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Зареждане на инспекции...</p>
    </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
    <div class="alert alert-danger">@errorMessage</div>
    }
    else if (inspections == null || !inspections.Any())
    {
    <div class="alert alert-info">Няма намерени инспекции.</div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Дата</th>
                    <th>Тип</th>
                    <th>Инспектор</th>
                    <th>Кораб</th>
                    <th>Разрешително</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inspection in inspections)
                {
                <tr>
                    <td>@inspection.Id</td>
                    <td>@inspection.InspectionDate.ToString("dd.MM.yyyy")</td>
                    <td>@inspection.InspectionType</td>
                    <td>@(inspection.InspectorName ?? "N/A")</td>
                    <td>@(inspection.ShipName ?? "N/A")</td>
                    <td>@(inspection.LicenseNumber ?? "N/A")</td>
                    <td>
                        <span class="badge bg-@(inspection.Status == "Completed" ? "success" : inspection.Status == "Violation" ? "danger" : "warning")">
                            @inspection.Status
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-info" @onclick="() => ViewInspection(inspection.Id)">Преглед</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteInspection(inspection.Id)">Изтрий</button>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
    }
</div>

<!-- Add Inspection Modal -->
@if (showAddInspectionModal)
{
<div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Добави нова инспекция</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseAddInspectionModal"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(addInspectionErrorMessage))
                {
                <div class="alert alert-danger">@addInspectionErrorMessage</div>
                }
                <EditForm Model="@newInspection" OnValidSubmit="HandleAddInspection">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ID на инспектор *</label>
                            <InputNumber @bind-Value="newInspection.InspectorId" class="form-control" />
                            <ValidationMessage For="@(() => newInspection.InspectorId)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ID на кораб</label>
                            <InputNumber @bind-Value="newInspection.ShipId" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ID на разрешително</label>
                            <InputNumber @bind-Value="newInspection.LicenseId" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Дата на инспекция *</label>
                            <InputDate @bind-Value="newInspection.InspectionDate" class="form-control" />
                            <ValidationMessage For="@(() => newInspection.InspectionDate)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Тип инспекция *</label>
                            <InputText @bind-Value="newInspection.InspectionType" class="form-control" placeholder="Напр. Рутенна проверка" />
                            <ValidationMessage For="@(() => newInspection.InspectionType)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Локация</label>
                            <InputText @bind-Value="newInspection.Location" class="form-control" placeholder="Напр. Пристанище Варна" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Статус *</label>
                            <InputSelect @bind-Value="newInspection.Status" class="form-select">
                                <option value="">Изберете...</option>
                                <option value="Completed">Завършена</option>
                                <option value="Pending">Изчакваща</option>
                                <option value="Violation">Нарушение</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => newInspection.Status)" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">Намерения</label>
                            <InputTextArea @bind-Value="newInspection.Findings" class="form-control" rows="3" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">Нарушения</label>
                            <InputTextArea @bind-Value="newInspection.Violations" class="form-control" rows="3" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">Предприети действия</label>
                            <InputTextArea @bind-Value="newInspection.ActionsTaken" class="form-control" rows="3" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">Бележки</label>
                            <InputTextArea @bind-Value="newInspection.Notes" class="form-control" rows="3" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseAddInspectionModal">Отказ</button>
                        <button type="submit" class="btn btn-primary" disabled="@isAddingInspection">
                            @if (isAddingInspection)
                            {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Запази
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
}

<!-- Modal за преглед на инспекция -->
@if (showViewInspectionModal && currentInspection != null)
{
<div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">Преглед на инспекция #@currentInspection.Id</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseViewInspectionModal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3"><strong>Инспектор:</strong> @(currentInspection.InspectorName ?? "N/A")</div>
                    <div class="col-md-6 mb-3"><strong>Дата:</strong> @currentInspection.InspectionDate.ToString("dd.MM.yyyy")</div>
                    <div class="col-md-6 mb-3"><strong>Тип:</strong> @(currentInspection.InspectionType ?? "N/A")</div>
                    <div class="col-md-6 mb-3"><strong>Локация:</strong> @(currentInspection.Location ?? "N/A")</div>
                    <div class="col-md-6 mb-3"><strong>Кораб:</strong> @(currentInspection.ShipName ?? "N/A")</div>
                    <div class="col-md-6 mb-3"><strong>Статус:</strong> <span class="badge bg-primary">@currentInspection.Status</span></div>
                    @if (!string.IsNullOrEmpty(currentInspection.Findings))
                    {
                    <div class="col-12 mb-3"><strong>Намерения:</strong><p class="mt-1">@currentInspection.Findings</p></div>
                    }
                    @if (!string.IsNullOrEmpty(currentInspection.Violations))
                    {
                    <div class="col-12 mb-3"><strong>Нарушения:</strong><p class="mt-1 text-danger">@currentInspection.Violations</p></div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseViewInspectionModal">Затвори</button>
            </div>
        </div>
    </div>
</div>
}

<!-- Modal за редактиране на инспекция -->
