@page "/my-catches"
@using IARA.Web.Services
@inject AuthenticatedHttpClient Http
@inject NavigationManager NavManager
@inject AuthService AuthService

<div class="container py-5 page-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">🐟 Моите Уловове</h2>
        <a href="/add-catch" class="btn btn-success rounded-pill px-4">
            <span class="me-2">+</span> Добави нов
        </a>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Зареждане на улововете...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @errorMessage
        </div>
    }
    else if (catches == null || !catches.Any())
    {
        <div class="text-center py-5 bg-light rounded-4">
            <div style="font-size: 3rem;">📭</div>
            <h4 class="mt-3">Все още нямате записани уловове</h4>
            <p class="text-muted">Споделете първия си успех!</p>
            <a href="/add-catch" class="btn btn-outline-primary mt-2">Добави улов</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in catches)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 hover-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-3">
                                <h5 class="card-title fw-bold text-primary">@item.FishSpecies</h5>
                                <span class="badge bg-info text-dark">@item.CatchDate.ToString("dd.MM.yyyy")</span>
                            </div>
                            
                            <div class="d-flex align-items-center mb-2">
                                <span class="text-muted me-2">Тегло:</span>
                                <strong>@(item.WeightKgs?.ToString("F2") ?? "-") кг</strong>
                            </div>

                            @if (item.Quantity.HasValue)
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <span class="text-muted me-2">Брой:</span>
                                    <strong>@item.Quantity бр.</strong>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.FishingLocation))
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <span class="text-muted me-2">📍</span>
                                    <span>@item.FishingLocation</span>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(item.FishingMethod))
                            {
                                <div class="text-muted small mt-2">
                                    <i class="bi bi-tools me-1"></i> @item.FishingMethod
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-card {
        transition: transform 0.2s;
    }
    .hover-card:hover {
        transform: translateY(-5px);
    }
</style>

@code {
    private List<AmateurCatchDTO>? catches;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await AuthService.GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                NavManager.NavigateTo("/login");
                return;
            }

            // Тук гърмеше преди, защото JSON-ът съдържаше null, а моделът чакаше int
            catches = await Http.GetFromJsonAsync<List<AmateurCatchDTO>>("api/AmateurCatches");
        }
        catch (Exception ex)
        {
            errorMessage = $"Грешка при зареждане: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // 👇 ЕТО ТУК Е РАЗКОВНИЧЕТО
    public class AmateurCatchDTO
    {
        public int Id { get; set; }
        public int? AmateurTicketId { get; set; } 
        public string FishSpecies { get; set; } = "";
        public decimal? WeightKgs { get; set; }
    
        // 👇 ТУК Е ВАЖНОТО: сложи въпросителна '?' след int
        public int? Quantity { get; set; }
    
        public string? FishingLocation { get; set; }
        public string? FishingMethod { get; set; }
        public DateTime CatchDate { get; set; }
    }
}