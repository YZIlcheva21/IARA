@page "/my-catches"
@using System.Net.Http.Json
@using IARA.Web.Services
@inject AuthenticatedHttpClient Http
@inject NavigationManager NavManager
@inject AuthService AuthService

<PageTitle>Моите Уловове - ИАРА</PageTitle>

@if (!authChecked)
{
    @* DO NOT RENDER ANYTHING until auth is checked *@
    <div style="display: none;"></div>
}
else if (!isAuthenticated)
{
    @* NOT AUTHENTICATED - redirect will happen *@
    <div style="display: none;"></div>
}
else
{
<div class="container-fluid p-4 page-container">
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="page-title mb-2">
                    <span class="page-icon">🐟</span>
                    Моите Уловове
                </h1>
                <p class="page-subtitle text-muted mb-0">Преглед на регистрираните любителски уловове</p>
            </div>
            <a href="/add-catch" class="btn btn-primary rounded-pill px-4 btn-add-action">
                <span class="oi oi-plus me-2"></span>Нов Улов
            </a>
        </div>
    </div>

    @if (isLoading)
    {
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Зареждане на уловове...</p>
    </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
    <div class="alert alert-danger">
        <strong>⚠️ Грешка:</strong> @errorMessage
    </div>
    }
    else if (catches == null || !catches.Any())
    {
    <div class="alert alert-info text-center">
        <h5>Няма записани уловове</h5>
        <p>Започнете да записвате вашите уловове!</p>
        <a href="/add-catch" class="btn btn-primary">Добави първи улов</a>
    </div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Дата</th>
                    <th>Вид Риба</th>
                    <th>Тегло (кг)</th>
                    <th>Количество</th>
                    <th>Място</th>
                    <th>Метод</th>
                    <th>Билет</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var catchItem in catches)
                {
                <tr>
                    <td>@catchItem.CatchDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td><strong>@catchItem.FishSpecies</strong></td>
                    <td>@catchItem.WeightKgs.ToString("F2") кг</td>
                    <td>@catchItem.Quantity</td>
                    <td>@(catchItem.FishingLocation ?? "N/A")</td>
                    <td>@(catchItem.FishingMethod ?? "N/A")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(catchItem.TicketNumber))
                        {
                        <span class="badge bg-success">@catchItem.TicketNumber</span>
                        }
                        else
                        {
                        <span class="text-muted">N/A</span>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="mt-4 p-3 bg-light rounded">
        <h5>Обща статистика</h5>
        <div class="row">
            <div class="col-md-4">
                <strong>Общо уловове:</strong> @catches.Count()
            </div>
            <div class="col-md-4">
                <strong>Общо тегло:</strong> @catches.Sum(c => c.WeightKgs).ToString("F2") кг
            </div>
            <div class="col-md-4">
                <strong>Средно тегло:</strong> @(catches.Any() ? (catches.Sum(c => c.WeightKgs) / catches.Count()).ToString("F2") : "0") кг
            </div>
        </div>
    </div>
    }
</div>
}

@code {
    private bool authChecked = false;
    private bool isAuthenticated = false;
    private AmateurCatchDto[]? catches;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Check authentication BEFORE rendering ANYTHING
        var token = await AuthService.GetTokenAsync();
        isAuthenticated = !string.IsNullOrEmpty(token) && !string.IsNullOrWhiteSpace(token);
        
        if (!isAuthenticated)
        {
            // NOT authenticated - redirect to login IMMEDIATELY
            authChecked = true;
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }
        
        // Authenticated - allow rendering
        authChecked = true;
        await LoadCatches();
    }

    private async Task LoadCatches()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            
            var response = await Http.GetFromJsonAsync<AmateurCatchDto[]>("api/AmateurCatches");
            catches = response;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Failed to fetch") || ex.Message.Contains("NetworkError"))
            {
                errorMessage = "⚠️ API сървърът не е достъпен. Моля стартирайте API проекта.";
            }
            else
            {
                errorMessage = $"Грешка при зареждане: {ex.Message}";
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    public class AmateurCatchDto
    {
        public int Id { get; set; }
        public string FishSpecies { get; set; } = string.Empty;
        public decimal WeightKgs { get; set; }
        public int Quantity { get; set; }
        public DateTime CatchDate { get; set; }
        public string? FishingLocation { get; set; }
        public string? FishingMethod { get; set; }
        public string? TicketNumber { get; set; }
    }
}
