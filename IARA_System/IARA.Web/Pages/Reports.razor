    private async Task LoadReport5()
    {
        try
        {
            if (!report5StartDate.HasValue || !report5EndDate.HasValue)
            {
                await JS.InvokeVoidAsync("alert", "Моля изберете начална и крайна дата!");
                return;
            }

            loadingReport5 = true;
            showReport5 = true;
            var url = $"api/Reports/inspections?startDate={report5StartDate.Value:yyyy-MM-dd}&endDate={report5EndDate.Value:yyyy-MM-dd}";
            var response = await Http.GetFromJsonAsync<InspectionReportDto[]>(url);
            inspectionsReport = response;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Failed to fetch") || ex.Message.Contains("NetworkError"))
            {
                await LoadMockReport5();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Грешка при зареждане на справка 5: {ex.Message}");
            }
        }
        finally
        {
            loadingReport5 = false;
        }
    }

