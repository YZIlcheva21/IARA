@page "/reports"
@using System.Net.Http.Json
@using System.Linq
@using IARA.Web.Services
@inject AuthenticatedHttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject AuthService AuthService

<PageTitle>Справки - ИАРА</PageTitle>

@if (!authChecked)
{
    @* DO NOT RENDER ANYTHING until auth is checked *@
    <div style="display: none;"></div>
}
else if (!isAuthenticated)
{
    @* NOT AUTHENTICATED - redirect will happen *@
    <div style="display: none;"></div>
}
else
{
<div class="container-fluid p-4">
    <div class="page-header mb-4">
        <h1 class="page-title mb-2">
            <span class="page-icon">📊</span>
            Справки и Анализи
        </h1>
        <p class="page-subtitle text-muted mb-0">Генериране на отчети и статистики</p>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Справка 1</h5>
                    <p class="card-text small">Кораби с изтичащо разрешително</p>
                    <div class="mb-3">
                        <label class="form-label small">Дни напред:</label>
                        <input type="number" class="form-control form-control-sm" @bind="report1Days" min="1" max="365" />
                    </div>
                    <button class="btn btn-primary btn-sm w-100" @onclick="LoadReport1">Зареди</button>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success">Справка 2</h5>
                    <p class="card-text small">Класация на рибари любители</p>
                    <div class="mb-3">
                        <label class="form-label small">Месеци назад:</label>
                        <input type="number" class="form-control form-control-sm" @bind="report2Months" min="1" max="60" />
                    </div>
                    <button class="btn btn-success btn-sm w-100" @onclick="LoadReport2">Зареди</button>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-info">Справка 3</h5>
                    <p class="card-text small">Анализ на улова по кораби</p>
                    <div class="mb-3">
                        <label class="form-label small">Година:</label>
                        <input type="number" class="form-control form-control-sm" @bind="report3Year" min="2000" max="@DateTime.Now.Year" />
                    </div>
                    <button class="btn btn-info btn-sm w-100" @onclick="LoadReport3">Зареди</button>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-warning">Справка 4</h5>
                    <p class="card-text small">Ефективност на горивото</p>
                    <div class="mb-3">
                        <label class="form-label small">Година:</label>
                        <input type="number" class="form-control form-control-sm" @bind="report4Year" min="2000" max="@DateTime.Now.Year" />
                    </div>
                    <button class="btn btn-warning btn-sm w-100" @onclick="LoadReport4">Зареди</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger">Справка 5</h5>
                    <p class="card-text small">Инспекции по период</p>
                    <div class="mb-2">
                        <label class="form-label small">От дата:</label>
                        <InputDate @bind-Value="report5StartDate" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">До дата:</label>
                        <InputDate @bind-Value="report5EndDate" class="form-control form-control-sm" />
                    </div>
                    <button class="btn btn-danger btn-sm w-100" @onclick="LoadReport5">Зареди</button>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-secondary">Справка 6</h5>
                    <p class="card-text small">Статистика за рибари</p>
                    <div class="mb-3">
                        <label class="form-label small">Година:</label>
                        <input type="number" class="form-control form-control-sm" @bind="report6Year" min="2000" max="@DateTime.Now.Year" />
                    </div>
                    <button class="btn btn-secondary btn-sm w-100" @onclick="LoadReport6">Зареди</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Report 1: Expiring Licenses -->
    @if (showReport1)
    {
    <div class="card shadow-lg border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Справка 1: Кораби с изтичащо разрешително (следващите @report1Days дни)</h4>
        </div>
        <div class="card-body">
            @if (loadingReport1)
            {
            <div class="text-center p-4">
                <div class="spinner-border text-primary"></div>
            </div>
            }
            else if (expiringLicenses != null && expiringLicenses.Any())
            {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Номер на разрешително</th>
                            <th>Международен номер на кораб</th>
                            <th>Собственик</th>
                            <th>Дата на изтичане</th>
                            <th>Оставащи дни</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var license in expiringLicenses)
                        {
                        <tr class="@(license.DaysRemaining <= 7 ? "table-warning" : "")">
                            <td><strong>@license.LicenseNumber</strong></td>
                            <td>@license.ShipInternationalNumber</td>
                            <td>@license.OwnerName</td>
                            <td>@license.ExpiryDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="badge @(license.DaysRemaining <= 7 ? "bg-danger" : "bg-warning")">
                                    @license.DaysRemaining дни
                                </span>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info">Няма кораби с изтичащи разрешителни в този период.</div>
            }
        </div>
    </div>
    }

    <!-- Report 2: Amateur Ranking -->
    @if (showReport2)
    {
    <div class="card shadow-lg border-0 mb-4">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Справка 2: Класация на рибари любители (последните @report2Months месеца)</h4>
        </div>
        <div class="card-body">
            @if (loadingReport2)
            {
            <div class="text-center p-4">
                <div class="spinner-border text-success"></div>
            </div>
            }
            else if (amateurRanking != null && amateurRanking.Any())
            {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Място</th>
                            <th>Име на рибар</th>
                            <th>Общ улов (кг)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rank = 1; }
                        @foreach (var fisher in amateurRanking.OrderByDescending(x => x.TotalCatchInKgs))
                        {
                        <tr>
                            <td>
                                @if (rank == 1)
                                {
                                <span class="badge bg-warning text-dark">🥇 @rank</span>
                                }
                                else if (rank == 2)
                                {
                                <span class="badge bg-secondary">🥈 @rank</span>
                                }
                                else if (rank == 3)
                                {
                                <span class="badge bg-warning">🥉 @rank</span>
                                }
                                else
                                {
                                <span>@rank</span>
                                }
                            </td>
                            <td><strong>@fisher.FisherName</strong></td>
                            <td><strong>@fisher.TotalCatchInKgs.ToString("F2") кг</strong></td>
                        </tr>
                        rank++;
                        }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info">Няма данни за любителски улов в този период.</div>
            }
        </div>
    </div>
    }

    <!-- Report 3: Ship Catch Analysis -->
    @if (showReport3)
    {
    <div class="card shadow-lg border-0 mb-4">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Справка 3: Анализ на улова по кораби за @report3Year г.</h4>
        </div>
        <div class="card-body">
            @if (loadingReport3)
            {
            <div class="text-center p-4">
                <div class="spinner-border text-info"></div>
            </div>
            }
            else if (shipCatchAnalysis != null && shipCatchAnalysis.Any())
            {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Международен номер</th>
                            <th>Брой излети</th>
                            <th>Общ улов (кг)</th>
                            <th>Мин. улов/излет (кг)</th>
                            <th>Макс. улов/излет (кг)</th>
                            <th>Среден улов/излет (кг)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ship in shipCatchAnalysis.OrderByDescending(x => x.TotalCatchKgs))
                        {
                        <tr>
                            <td><strong>@ship.ShipInternationalNumber</strong></td>
                            <td>@ship.TotalTrips</td>
                            <td><strong>@ship.TotalCatchKgs.ToString("F2")</strong></td>
                            <td>@ship.MinCatchPerTripKgs.ToString("F2")</td>
                            <td>@ship.MaxCatchPerTripKgs.ToString("F2")</td>
                            <td><strong>@ship.AvgCatchPerTripKgs.ToString("F2")</strong></td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info">Няма данни за улов през @report3Year г.</div>
            }
        </div>
    </div>
    }

    <!-- Report 4: Fuel Efficiency -->
    @if (showReport4)
    {
    <div class="card shadow-lg border-0 mb-4">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Справка 4: Ефективност на горивото за @report4Year г.</h4>
        </div>
        <div class="card-body">
            @if (loadingReport4)
            {
            <div class="text-center p-4">
                <div class="spinner-border text-warning"></div>
            </div>
            }
            else if (fuelEfficiency != null && fuelEfficiency.Any())
            {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Международен номер</th>
                            <th>Общ улов (кг)</th>
                            <th>Общо гориво (кг)</th>
                            <th>Общо часове</th>
                            <th>Гориво/кг улов</th>
                            <th>Среден разход/час</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ship in fuelEfficiency.OrderBy(x => x.FuelPerKgCatch))
                        {
                        <tr>
                            <td><strong>@ship.ShipInternationalNumber</strong></td>
                            <td>@ship.TotalCatchKgs.ToString("F2")</td>
                            <td>@ship.TotalFuelUsed.ToString("F2")</td>
                            <td>@ship.TotalFishingHours.ToString("F1")</td>
                            <td><strong>@ship.FuelPerKgCatch.ToString("F3")</strong></td>
                            <td>@ship.AvgFuelPerHour.ToString("F2")</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info">Няма данни за ефективност на горивото през @report4Year г.</div>
            }
        </div>
    </div>
    }

    <!-- Report 5: Inspections by Period -->
    @if (showReport5)
    {
    <div class="card shadow-lg border-0 mb-4">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Справка 5: Инспекции по период (@report5StartDate?.ToString("dd.MM.yyyy") - @report5EndDate?.ToString("dd.MM.yyyy"))</h4>
        </div>
        <div class="card-body">
            @if (loadingReport5)
            {
            <div class="text-center p-4">
                <div class="spinner-border text-danger"></div>
            </div>
            }
            else if (inspectionsReport != null && inspectionsReport.Any())
            {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Тип</th>
                            <th>Локация</th>
                            <th>Инспектор</th>
                            <th>Кораб</th>
                            <th>Статус</th>
                            <th>Нарушения</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inspection in inspectionsReport)
                        {
                        <tr>
                            <td>@inspection.InspectionDate.ToString("dd.MM.yyyy")</td>
                            <td>@inspection.InspectionType</td>
                            <td>@(inspection.Location ?? "N/A")</td>
                            <td>@(inspection.InspectorName ?? "N/A")</td>
                            <td>@(inspection.ShipName ?? "N/A")</td>
                            <td>
                                <span class="badge bg-@(inspection.Status == "Completed" ? "success" : inspection.Status == "Violation" ? "danger" : "warning")">
                                    @inspection.Status
                                </span>
                            </td>
                            <td>@(inspection.ViolationsFound ? "Да" : "Не")</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info">Няма данни за инспекции за избрания период.</div>
            }
        </div>
    </div>
    }

    <!-- Report 6: Fisher Statistics -->
    @if (showReport6)
    {
    <div class="card shadow-lg border-0 mb-4">
        <div class="card-header bg-secondary text-white">
            <h4 class="mb-0">Справка 6: Статистика за рибари (@report6Year г.)</h4>
        </div>
        <div class="card-body">
            @if (loadingReport6)
            {
            <div class="text-center p-4">
                <div class="spinner-border text-secondary"></div>
            </div>
            }
            else if (fisherStatistics != null && fisherStatistics.Any())
            {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID на рибар</th>
                            <th>Име</th>
                            <th>Общо разрешителни</th>
                            <th>Активни разрешителни</th>
                            <th>Собствени кораби</th>
                            <th>Любителски улов (кг)</th>
                            <th>Професионален улов (кг)</th>
                            <th>Общ улов (кг)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fisher in fisherStatistics)
                        {
                        <tr>
                            <td>@fisher.FisherId</td>
                            <td><strong>@fisher.FisherName</strong></td>
                            <td>@fisher.TotalLicenses</td>
                            <td>@fisher.ActiveLicenses</td>
                            <td>@fisher.OwnedShips</td>
                            <td>@fisher.AmateurCatchesKgs.ToString("F2")</td>
                            <td>@fisher.ProfessionalCatchesKgs.ToString("F2")</td>
                            <td><strong>@((fisher.AmateurCatchesKgs + fisher.ProfessionalCatchesKgs).ToString("F2"))</strong></td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info">Няма данни за статистика на рибари през @report6Year г.</div>
            }
        </div>
    </div>
    }
</div>
}

@code {
    private bool authChecked = false;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        // Check authentication BEFORE rendering ANYTHING
        var token = await AuthService.GetTokenAsync();
        isAuthenticated = !string.IsNullOrEmpty(token) && !string.IsNullOrWhiteSpace(token);
        
        if (!isAuthenticated)
        {
            // NOT authenticated - redirect to login IMMEDIATELY
            authChecked = true;
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }
        
        // Authenticated - allow rendering
        authChecked = true;
    }
    private int report1Days = 30;
    private int report2Months = 12;
    private int report3Year = DateTime.Now.Year;
    private int report4Year = DateTime.Now.Year;
    private DateTime? report5StartDate = DateTime.Today.AddMonths(-1);
    private DateTime? report5EndDate = DateTime.Today;
    private int report6Year = DateTime.Now.Year;

    private bool showReport1 = false;
    private bool showReport2 = false;
    private bool showReport3 = false;
    private bool showReport4 = false;
    private bool showReport5 = false;
    private bool showReport6 = false;

    private bool loadingReport1 = false;
    private bool loadingReport2 = false;
    private bool loadingReport3 = false;
    private bool loadingReport4 = false;
    private bool loadingReport5 = false;
    private bool loadingReport6 = false;

    private ExpiringLicenseDto[]? expiringLicenses;
    private AmateurRankingDto[]? amateurRanking;
    private ShipCatchAnalysisDto[]? shipCatchAnalysis;
    private ShipFuelEfficiencyDto[]? fuelEfficiency;
    private InspectionReportDto[]? inspectionsReport;
    private FisherStatisticsDto[]? fisherStatistics;

    private async Task LoadReport1()
    {
        try
        {
            loadingReport1 = true;
            showReport1 = true;
            var response = await Http.GetFromJsonAsync<ExpiringLicenseDto[]>($"api/Reports/expiring-licenses?daysAhead={report1Days}");
            expiringLicenses = response;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Failed to fetch") || ex.Message.Contains("NetworkError"))
            {
                // Use mock data when API is not available
                await LoadMockReport1();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Грешка при зареждане на справка 1: {ex.Message}");
            }
        }
        finally
        {
            loadingReport1 = false;
        }
    }

    private async Task LoadMockReport1()
    {
        await Task.Delay(500); // Simulate loading
        expiringLicenses = new ExpiringLicenseDto[]
        {
            new ExpiringLicenseDto
            {
                LicenseId = 1,
                LicenseNumber = "LIC-2024-001",
                ShipInternationalNumber = "IMO1234567",
                OwnerName = "Иван Петров",
                ExpiryDate = DateTime.Now.AddDays(15),
                DaysRemaining = 15
            },
            new ExpiringLicenseDto
            {
                LicenseId = 2,
                LicenseNumber = "LIC-2024-005",
                ShipInternationalNumber = "IMO1111111",
                OwnerName = "Петър Стоянов",
                ExpiryDate = DateTime.Now.AddDays(25),
                DaysRemaining = 25
            }
        };
    }

    private async Task LoadReport2()
    {
        try
        {
            loadingReport2 = true;
            showReport2 = true;
            var response = await Http.GetFromJsonAsync<AmateurRankingDto[]>($"api/Reports/amateur-ranking?lastMonths={report2Months}");
            amateurRanking = response;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Failed to fetch") || ex.Message.Contains("NetworkError"))
            {
                // Use mock data when API is not available
                await LoadMockReport2();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Грешка при зареждане на справка 2: {ex.Message}");
            }
        }
        finally
        {
            loadingReport2 = false;
        }
    }

    private async Task LoadMockReport2()
    {
        await Task.Delay(500);
        amateurRanking = new AmateurRankingDto[]
        {
            new AmateurRankingDto { FisherId = 1, FisherName = "Мария Димитрова", TotalCatchInKgs = 125.5 },
            new AmateurRankingDto { FisherId = 2, FisherName = "Георги Петров", TotalCatchInKgs = 98.3 },
            new AmateurRankingDto { FisherId = 3, FisherName = "Иван Стоянов", TotalCatchInKgs = 87.2 },
            new AmateurRankingDto { FisherId = 4, FisherName = "Анна Иванова", TotalCatchInKgs = 76.8 },
            new AmateurRankingDto { FisherId = 5, FisherName = "Димитър Георгиев", TotalCatchInKgs = 65.4 }
        };
    }

    private async Task LoadReport3()
    {
        try
        {
            loadingReport3 = true;
            showReport3 = true;
            var response = await Http.GetFromJsonAsync<ShipCatchAnalysisDto[]>($"api/Reports/ship-catch-analysis/{report3Year}");
            shipCatchAnalysis = response;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Failed to fetch") || ex.Message.Contains("NetworkError"))
            {
                // Use mock data when API is not available
                await LoadMockReport3();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Грешка при зареждане на справка 3: {ex.Message}");
            }
        }
        finally
        {
            loadingReport3 = false;
        }
    }

    private async Task LoadMockReport3()
    {
        await Task.Delay(500);
        shipCatchAnalysis = new ShipCatchAnalysisDto[]
        {
            new ShipCatchAnalysisDto
            {
                ShipInternationalNumber = "IMO1234567",
                TotalTrips = 45,
                TotalCatchKgs = 5420.5,
                MaxCatchPerTripKgs = 180.3,
                MinCatchPerTripKgs = 65.8,
                AvgCatchPerTripKgs = 120.5
            },
            new ShipCatchAnalysisDto
            {
                ShipInternationalNumber = "IMO7654321",
                TotalTrips = 32,
                TotalCatchKgs = 3120.8,
                MaxCatchPerTripKgs = 150.2,
                MinCatchPerTripKgs = 45.3,
                AvgCatchPerTripKgs = 97.5
            },
            new ShipCatchAnalysisDto
            {
                ShipInternationalNumber = "IMO9876543",
                TotalTrips = 28,
                TotalCatchKgs = 2890.6,
                MaxCatchPerTripKgs = 135.7,
                MinCatchPerTripKgs = 52.1,
                AvgCatchPerTripKgs = 103.2
            }
        };
    }

    private async Task LoadReport4()
    {
        try
        {
            loadingReport4 = true;
            showReport4 = true;
            var response = await Http.GetFromJsonAsync<ShipFuelEfficiencyDto[]>($"api/Reports/ship-fuel-efficiency/{report4Year}");
            fuelEfficiency = response;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Failed to fetch") || ex.Message.Contains("NetworkError"))
            {
                // Use mock data when API is not available
                await LoadMockReport4();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Грешка при зареждане на справка 4: {ex.Message}");
            }
        }
        finally
        {
            loadingReport4 = false;
        }
    }

    private async Task LoadMockReport4()
    {
        await Task.Delay(500);
        fuelEfficiency = new ShipFuelEfficiencyDto[]
        {
            new ShipFuelEfficiencyDto
