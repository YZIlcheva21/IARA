@page "/licenses"
@using System.Net.Http.Json
@using System.Linq
@using IARA.Web.Services
@inject AuthenticatedHttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject AuthService AuthService

<PageTitle>Разрешителни - ИАРА</PageTitle>

@if (!authChecked)
{
    @* Чакаме проверка на автентикацията *@
    <div style="display: none;"></div>
}
else if (!isAuthenticated)
{
    @* Не сме логнати - ще се пренасочи *@
    <div style="display: none;"></div>
}
else
{
<div class="container-fluid p-4">
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="page-title mb-2">
                    <span class="page-icon">📄</span>
                    Разрешителна за риболов
                </h1>
                <p class="page-subtitle text-muted mb-0">Управление на разрешителни за риболов</p>
            </div>
            <button class="btn btn-primary rounded-pill px-4 btn-add-action" @onclick="ShowAddLicenseModal">
                <span class="oi oi-plus me-2"></span>Ново Разрешително
            </button>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <select class="form-select" @bind="statusFilter" @bind:event="onchange">
                <option value="">Всички статуси</option>
                <option value="Active">Активни</option>
                <option value="Expired">Изтекли</option>
                <option value="Revoked">Отнети</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="text" class="form-control" placeholder="Търсене по номер..." @bind="searchTerm" @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100" @onclick="LoadLicenses">Търси</button>
        </div>
        <div class="col-md-2">
            <div class="form-check form-switch mt-2">
                <input class="form-check-input" type="checkbox" @bind="expiringSoonFilter" @bind:event="onchange" />
                <label class="form-check-label">Изтичащи скоро</label>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Зареждане на разрешителни...</p>
    </div>
    }
    else if (licenses == null || !licenses.Any())
    {
    <div class="alert alert-info text-center">Няма намерени разрешителни</div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Номер</th>
                    <th>Рибар</th>
                    <th>Кораб</th>
                    <th>Дата на издаване</th>
                    <th>Дата на изтичане</th>
                    <th>Статус</th>
                    <th>Тип</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var license in licenses)
                {
                <tr>
                    <td><strong>@license.LicenseNumber</strong></td>
                    <td>@(license.FisherName ?? "N/A")</td>
                    <td>@(license.ShipName ?? "N/A")</td>
                    <td>@license.IssueDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (license.ExpiryDate.HasValue)
                        {
                        var daysRemaining = (license.ExpiryDate.Value - DateTime.Now).Days;
                        <span class="@(daysRemaining <= 30 ? "text-danger fw-bold" : "")">
                            @license.ExpiryDate.Value.ToString("dd.MM.yyyy")
                            @if (daysRemaining <= 30 && daysRemaining >= 0)
                            {
                            <span class="badge bg-warning">@daysRemaining дни</span>
                            }
                        </span>
                        }
                        else
                        {
                        <span class="text-muted">N/A</span>
                        }
                    </td>
                    <td>
                        @if (license.Status == "Active")
                        {
                        <span class="badge bg-success">Активно</span>
                        }
                        else if (license.Status == "Expired")
                        {
                        <span class="badge bg-secondary">Изтекло</span>
                        }
                        else if (license.Status == "Revoked")
                        {
                        <span class="badge bg-danger">Отнето</span>
                        }
                        else
                        {
                        <span class="badge bg-secondary">@license.Status</span>
                        }
                    </td>
                    <td>@(license.LicenseType ?? "N/A")</td>
                    
                    <td>
                        <button class="btn btn-sm btn-outline-warning me-2" @onclick="() => EditLicense(license.Id)" title="Редактирай">
                            ✏️
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLicense(license.Id)" title="Изтрий">
                            🗑️
                        </button>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
    }
</div>

@if (showAddLicenseModal)
{
<div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">
                    <span class="oi oi-document me-2"></span>Добави ново разрешително
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseAddLicenseModal"></button>
            </div>
            <div class="modal-body p-4">
                @if (!string.IsNullOrEmpty(addLicenseErrorMessage))
                {
                <div class="alert alert-danger">@addLicenseErrorMessage</div>
                }
                @if (!string.IsNullOrEmpty(addLicenseSuccessMessage))
                {
                <div class="alert alert-success">@addLicenseSuccessMessage</div>
                }
                
                <EditForm Model="@newLicense" OnValidSubmit="HandleAddLicense">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Номер на разрешителното *</label>
                            <InputText @bind-Value="newLicense.LicenseNumber" class="form-control" placeholder="Напр. LIC-2024-001" />
                            <ValidationMessage For="@(() => newLicense.LicenseNumber)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">ID на рибар *</label>
                            <InputNumber @bind-Value="newLicense.FisherId" class="form-control" placeholder="Въведете ID на рибар" />
                            <ValidationMessage For="@(() => newLicense.FisherId)" />
                            <small class="text-muted">Въведете ID на рибар от базата данни</small>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ID на кораб</label>
                            <InputNumber @bind-Value="newLicense.ShipId" class="form-control" placeholder="Опционално" />
                            <small class="text-muted">Въведете ID на кораб от базата данни</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Тип разрешително</label>
                            <InputSelect @bind-Value="newLicense.LicenseType" class="form-select">
                                <option value="">Изберете...</option>
                                <option value="Професионален риболов">Професионален риболов</option>
                                <option value="Любителски риболов">Любителски риболов</option>
                                <option value="Спортен риболов">Спортен риболов</option>
                                <option value="Търговски риболов">Търговски риболов</option>
                            </InputSelect>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Дата на издаване *</label>
                            <InputDate @bind-Value="newLicense.IssueDate" class="form-control" min="@DateTime.Today.AddYears(-10).ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <ValidationMessage For="@(() => newLicense.IssueDate)" />
                            <small class="text-muted">Максимум до днес</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Дата на изтичане</label>
                            <InputDate @bind-Value="newLicense.ExpiryDate" class="form-control" min="@(newLicense.IssueDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" max="@DateTime.Today.AddYears(10).ToString("yyyy-MM-dd")" />
                            <ValidationMessage For="@(() => newLicense.ExpiryDate)" />
                            <small class="text-muted">Трябва да е след датата на издаване</small>
                            @if (newLicense.ExpiryDate.HasValue && newLicense.IssueDate.HasValue && newLicense.ExpiryDate.Value <= newLicense.IssueDate.Value)
                            {
                            <div class="text-danger small">Датата на изтичане трябва да е след датата на издаване!</div>
                            }
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Статус</label>
                            <InputSelect @bind-Value="newLicense.Status" class="form-select">
                                <option value="Active">Активно</option>
                                <option value="Expired">Изтекло</option>
                                <option value="Revoked">Отнето</option>
                                <option value="Suspended">Суспендирано</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Издаващ орган</label>
                            <InputText @bind-Value="newLicense.IssuingAuthority" class="form-control" placeholder="Напр. ИАРА Варна" />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Бележки</label>
                        <textarea @bind="newLicense.Notes" class="form-control" rows="3" placeholder="Допълнителни бележки..."></textarea>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseAddLicenseModal">Отказ</button>
                        <button type="submit" class="btn btn-primary" disabled="@isAddingLicense">
                            @if (isAddingLicense)
                            {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <span class="oi oi-check me-2"></span>Запази
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
}
}

@code {
    private bool authChecked = false;
    private bool isAuthenticated = false;
    private LicenseDto[]? licenses;
    private bool isLoading = false;
    private string statusFilter = "";
    private string searchTerm = "";
    private bool expiringSoonFilter = false;

    protected override async Task OnInitializedAsync()
    {
        var token = await AuthService.GetTokenAsync();
        isAuthenticated = !string.IsNullOrEmpty(token) && !string.IsNullOrWhiteSpace(token);
        
        if (!isAuthenticated)
        {
            authChecked = true;
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }
        
        authChecked = true;
        await LoadLicenses();
    }

    private async Task LoadLicenses()
    {
        try
        {
            isLoading = true;
            var queryParams = new List<string>();
            
            if (!string.IsNullOrEmpty(statusFilter))
                queryParams.Add($"status={statusFilter}");
            
            if (expiringSoonFilter)
                queryParams.Add("expiringSoon=true");
            
            var queryString = queryParams.Any() ? "?" + string.Join("&", queryParams) : "";
            var response = await Http.GetFromJsonAsync<LicenseDto[]>($"api/Licenses{queryString}");
            licenses = response;
            
            if (!string.IsNullOrEmpty(searchTerm) && licenses != null)
            {
                licenses = licenses.Where(l => 
                    l.LicenseNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (l.FisherName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (l.ShipName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                ).ToArray();
            }
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Failed to fetch") || ex.Message.Contains("NetworkError"))
            {
                await LoadMockLicenses();
                await JS.InvokeVoidAsync("alert", "⚠️ API сървърът не е достъпен. Показват се примерни данни.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Грешка при зареждане: {ex.Message}");
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMockLicenses()
    {
        await Task.Delay(500); 
        licenses = new LicenseDto[]
        {
            new LicenseDto { Id = 1, LicenseNumber = "LIC-2024-001", FisherName = "Иван Петров", IssueDate = DateTime.Now.AddMonths(-6), ExpiryDate = DateTime.Now.AddDays(15), Status = "Active", LicenseType = "Професионален" },
            new LicenseDto { Id = 2, LicenseNumber = "LIC-2024-002", FisherName = "Георги Иванов", IssueDate = DateTime.Now.AddMonths(-12), ExpiryDate = DateTime.Now.AddMonths(6), Status = "Active", LicenseType = "Професионален" }
        };
    }

    // 👇 НОВИ МЕТОДИ ЗА БУТОНИТЕ 👇
    private void EditLicense(int id)
    {
        // Навигация към страница за редакция (тази страница трябва да се създаде)
        NavManager.NavigateTo($"/licenses/edit/{id}");
    }

    private async Task DeleteLicense(int id)
    {
        // 1. Потвърждение
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Сигурни ли сте, че искате да изтриете това разрешително?");
        
        if (confirmed)
        {
            try
            {
                // 2. Изтриване от сървъра
                var response = await Http.DeleteAsync($"api/Licenses/{id}");
                if (response.IsSuccessStatusCode)
                {
                    // 3. Обновяване на екрана
                    if (licenses != null)
                    {
                        licenses = licenses.Where(l => l.Id != id).ToArray();
                    }
                    await JS.InvokeVoidAsync("alert", "Разрешителното беше изтрито успешно!");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Грешка при изтриване. Опитайте отново.");
                }
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Възникна грешка: {ex.Message}");
            }
        }
    }
    // 👆 КРАЙ НА НОВИТЕ МЕТОДИ 👆

    private bool showAddLicenseModal = false;
    private bool isAddingLicense = false;
    private string? addLicenseErrorMessage;
    private string? addLicenseSuccessMessage;
    private CreateLicenseModel newLicense = new();

    private void ShowAddLicenseModal()
    {
        showAddLicenseModal = true;
        newLicense = new CreateLicenseModel { IssueDate = DateTime.Now, Status = "Active" };
        addLicenseErrorMessage = null;
        addLicenseSuccessMessage = null;
    }

    private void CloseAddLicenseModal()
    {
        showAddLicenseModal = false;
        newLicense = new CreateLicenseModel();
        addLicenseErrorMessage = null;
        addLicenseSuccessMessage = null;
    }

    private async Task HandleAddLicense()
    {
        try
        {
            isAddingLicense = true;
            addLicenseErrorMessage = null;
            addLicenseSuccessMessage = null;

            if (string.IsNullOrWhiteSpace(newLicense.LicenseNumber))
            {
                addLicenseErrorMessage = "Номерът на разрешителното е задължителен!";
                isAddingLicense = false;
                return;
            }

            if (!newLicense.FisherId.HasValue || newLicense.FisherId.Value <= 0)
            {
                addLicenseErrorMessage = "ID на рибар е задължително!";
                isAddingLicense = false;
                return;
            }

            if (!newLicense.IssueDate.HasValue)
            {
                addLicenseErrorMessage = "Датата на издаване е задължителна!";
                isAddingLicense = false;
                return;
            }

            if (newLicense.ExpiryDate.HasValue && newLicense.ExpiryDate.Value <= newLicense.IssueDate.Value)
            {
                addLicenseErrorMessage = "Датата на изтичане трябва да е след датата на издаване!";
                isAddingLicense = false;
                return;
            }

            var createLicenseDto = new
            {
                LicenseNumber = newLicense.LicenseNumber,
                FisherId = newLicense.FisherId.Value,
                ShipId = newLicense.ShipId,
                IssueDate = newLicense.IssueDate.Value,
                ExpiryDate = newLicense.ExpiryDate,
                Status = newLicense.Status ?? "Active",
                LicenseType = newLicense.LicenseType,
                IssuingAuthority = newLicense.IssuingAuthority,
                Notes = newLicense.Notes
            };

            var response = await Http.PostAsJsonAsync("api/Licenses", createLicenseDto);

            if (response.IsSuccessStatusCode)
            {
                addLicenseSuccessMessage = "Разрешителното е добавено успешно!";
                await Task.Delay(1500);
                CloseAddLicenseModal();
                await LoadLicenses();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                addLicenseErrorMessage = $"Грешка при добавяне: {response.StatusCode} - {errorContent}";
                isAddingLicense = false;
            }
        }
        catch (Exception ex)
        {
            addLicenseErrorMessage = $"Грешка: {ex.Message}";
            isAddingLicense = false;
        }
    }

    public class LicenseDto
    {
        public int Id { get; set; }
        public string LicenseNumber { get; set; } = string.Empty;
        public int FisherId { get; set; }
        public string? FisherName { get; set; }
        public int? ShipId { get; set; }
        public string? ShipName { get; set; }
        public DateTime IssueDate { get; set; }
        public DateTime? ExpiryDate { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? LicenseType { get; set; }
    }

    public class CreateLicenseModel
    {
        public string LicenseNumber { get; set; } = "";
        public int? FisherId { get; set; }
        public int? ShipId { get; set; }
        public DateTime? IssueDate { get; set; } = DateTime.Today;
        public DateTime? ExpiryDate { get; set; }
        public string? Status { get; set; } = "Active";
        public string? LicenseType { get; set; }
        public string? IssuingAuthority { get; set; }
        public string? Notes { get; set; }
    }
}