private async Task ConfirmDeleteShip(int shipId)
{
    var ship = ships?.FirstOrDefault(s => s.Id == shipId);
    var shipName = ship?.Name ?? "този кораб";
    
    var confirmed = await JS.InvokeAsync<bool>("confirm", $"Сигурни ли сте, че искате да изтриете {shipName}? Това действие не може да бъде отменено!");
    
    if (confirmed)
    {
        await DeleteShip(shipId);
    }
}

private async Task DeleteShip(int shipId)
{
    try
    {
        var response = await Http.DeleteAsync($"api/ShipRegistry/{shipId}");
        
        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "Корабът е изтрит успешно!");
            await LoadShips(); // Reload the list
        }
        else
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Грешка при изтриване: {response.StatusCode} - {errorContent}");
        }
    }
    catch (Exception ex)
    {
        await JS.InvokeVoidAsync("alert", $"Грешка: {ex.Message}");
    }
}

private bool showAddShipModal = false;
private bool isAddingShip = false;
private string? addShipErrorMessage;
private string? addShipSuccessMessage;
private CreateShipModel newShip = new();
private int? builtYearValue;

// View/Edit Ship
private bool showViewShipModal = false;
private bool showEditShipModal = false;
private bool isUpdatingShip = false;
private ShipDetailDto? currentShip;
private UpdateShipModel? editShipModel;
private int? editBuiltYearValue;

private void ShowAddShipModal()
{
    showAddShipModal = true;
    newShip = new CreateShipModel();
    builtYearValue = null;
    addShipErrorMessage = null;
    addShipSuccessMessage = null;
}

private void CloseAddShipModal()
{
    showAddShipModal = false;
    newShip = new CreateShipModel();
    builtYearValue = null;
    addShipErrorMessage = null;
    addShipSuccessMessage = null;
}

private async Task HandleAddShip()
{
    try
    {
        isAddingShip = true;
        addShipErrorMessage = null;
        addShipSuccessMessage = null;

        // Validate required fields
        if (string.IsNullOrWhiteSpace(newShip.Name))
        {
            addShipErrorMessage = "Името на кораба е задължително!";
            return;
        }

        if (string.IsNullOrWhiteSpace(newShip.InternationalNumber))
        {
            addShipErrorMessage = "Международният номер (IMO) е задължителен!";
            return;
        }

        // Validate numeric fields
        if (newShip.Length.HasValue && newShip.Length <= 0)
        {
            addShipErrorMessage = "Дължината трябва да бъде по-голяма от 0!";
            return;
        }

        if (newShip.Width.HasValue && newShip.Width <= 0)
        {
            addShipErrorMessage = "Ширината трябва да бъде по-голяма от 0!";
            return;
        }

        if (newShip.EnginePower.HasValue && newShip.EnginePower <= 0)
        {
            addShipErrorMessage = "Мощността трябва да бъде по-голяма от 0!";
            return;
        }

        if (newShip.AverageFuelConsumptionPerHour.HasValue && newShip.AverageFuelConsumptionPerHour <= 0)
        {
            addShipErrorMessage = "Средният разход трябва да бъде по-голям от 0!";
            return;
        }

        // Validate year
        if (builtYearValue.HasValue)
        {
            if (builtYearValue < 1900 || builtYearValue > DateTime.Now.Year + 1)
            {
                addShipErrorMessage = $"Година на построяване трябва да бъде между 1900 и {DateTime.Now.Year + 1}!";
                return;
            }
            newShip.BuiltYear = new DateTime(builtYearValue.Value, 1, 1);
        }

        // Create DTO for API
        var createShipDto = new
        {
            Name = newShip.Name,
            InternationalNumber = newShip.InternationalNumber,
            CallSign = newShip.CallSign,
            Marking = newShip.Marking,
            RegistrationNumber = newShip.RegistrationNumber,
            HomePort = newShip.HomePort,
            Length = newShip.Length,
            Width = newShip.Width,
            GrossTonnage = newShip.GrossTonnage,
            Draught = newShip.Draught,
            EnginePower = newShip.EnginePower,
            EngineType = newShip.EngineType,
            FuelType = newShip.FuelType,
            AverageFuelConsumptionPerHour = newShip.AverageFuelConsumptionPerHour,
            BuiltYear = newShip.BuiltYear,
            OwnerId = newShip.OwnerId,
            CaptainId = newShip.CaptainId,
            OperatorId = newShip.OperatorId
        };

        var response = await Http.PostAsJsonAsync("api/ShipRegistry", createShipDto);

        if (response.IsSuccessStatusCode)
        {
            addShipSuccessMessage = "Корабът е добавен успешно!";
            await Task.Delay(1500);
            CloseAddShipModal();
            await LoadShips(); // Reload the list
        }
        else
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                addShipErrorMessage = "Нямате права за създаване на кораби. Трябва да сте Admin или RegistryOfficer!";
            }
            else
            {
                addShipErrorMessage = $"Грешка при добавяне: {response.StatusCode} - {errorContent}";
            }
            isAddingShip = false;
        }
    }
    catch (Exception ex)
    {
        addShipErrorMessage = $"Грешка: {ex.Message}";
        isAddingShip = false;
    }
}

private async Task ViewShipDetails(int shipId)
{
    try
    {
        var ship = await Http.GetFromJsonAsync<ShipDetailDto>($"api/ShipRegistry/{shipId}");
        if (ship != null)
        {
            currentShip = ship;
            showViewShipModal = true;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Корабът не е намерен!");
        }
    }
    catch (Exception ex)
    {
        await JS.InvokeVoidAsync("alert", $"Грешка: {ex.Message}");
    }
}

private async Task EditShip(int shipId)
{
    try
    {
        var ship = await Http.GetFromJsonAsync<ShipDetailDto>($"api/ShipRegistry/{shipId}");
        if (ship != null)
        {
            editShipModel = new UpdateShipModel
            {
                Id = ship.Id,
                Name = ship.Name,
                InternationalNumber = ship.InternationalNumber,
                CallSign = ship.CallSign,
                Marking = ship.Marking,
                RegistrationNumber = ship.RegistrationNumber,
                HomePort = ship.HomePort,
                Length = ship.Length,
                Width = ship.Width,
                GrossTonnage = ship.GrossTonnage,
                Draught = ship.Draught,
                EnginePower = ship.EnginePower,
                EngineType = ship.EngineType,
                FuelType = ship.FuelType,
                AverageFuelConsumptionPerHour = ship.AverageFuelConsumptionPerHour,
                BuiltYear = ship.BuiltYear,
                IsActive = ship.IsActive,
                OwnerId = ship.OwnerId,
                CaptainId = ship.CaptainId,
                OperatorId = ship.OperatorId
            };
            editBuiltYearValue = ship.BuiltYear?.Year;
            showEditShipModal = true;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Корабът не е намерен!");
        }
    }
    catch (Exception ex)
    {
        await JS.InvokeVoidAsync("alert", $"Грешка: {ex.Message}");
    }
}

private void CloseViewShipModal()
{
    showViewShipModal = false;
    currentShip = null;
}

private void CloseEditShipModal()
{
    showEditShipModal = false;
    editShipModel = null;
    editBuiltYearValue = null;
}

private async Task HandleUpdateShip()
{
    if (editShipModel == null) return;

    try
    {
        isUpdatingShip = true;
        addShipErrorMessage = null;

        // Validate year
        if (editBuiltYearValue.HasValue)
        {
            if (editBuiltYearValue < 1900 || editBuiltYearValue > DateTime.Now.Year + 1)
            {
                addShipErrorMessage = $"Година на построяване трябва да бъде между 1900 и {DateTime.Now.Year + 1}!";
                return;
            }
            editShipModel.BuiltYear = new DateTime(editBuiltYearValue.Value, 1, 1);
        }

        var updateDto = new
        {
            Id = editShipModel.Id,
            Name = editShipModel.Name,
            InternationalNumber = editShipModel.InternationalNumber,
            CallSign = editShipModel.CallSign,
            Marking = editShipModel.Marking,
            RegistrationNumber = editShipModel.RegistrationNumber,
            HomePort = editShipModel.HomePort,
            Length = editShipModel.Length,
            Width = editShipModel.Width,
            GrossTonnage = editShipModel.GrossTonnage,
            Draught = editShipModel.Draught,
            EnginePower = editShipModel.EnginePower,
            EngineType = editShipModel.EngineType,
            FuelType = editShipModel.FuelType,
            AverageFuelConsumptionPerHour = editShipModel.AverageFuelConsumptionPerHour,
            BuiltYear = editShipModel.BuiltYear,
            IsActive = editShipModel.IsActive,
            OwnerId = editShipModel.OwnerId,
            CaptainId = editShipModel.CaptainId,
            OperatorId = editShipModel.OperatorId
        };

        var response = await Http.PutAsJsonAsync($"api/ShipRegistry/{editShipModel.Id}", updateDto);

        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "Корабът е актуализиран успешно!");
            CloseEditShipModal();
            await LoadShips();
        }
        else
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            addShipErrorMessage = $"Грешка при актуализация: {response.StatusCode} - {errorContent}";
        }
    }
    catch (Exception ex)
    {
        addShipErrorMessage = $"Грешка: {ex.Message}";
    }
    finally
    {
        isUpdatingShip = false;
    }
}

