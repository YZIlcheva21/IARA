                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
}

@code {
private ShipDto[]? ships;
private bool isLoading = true;
private string? errorMessage;
private int currentPage = 1;
private int totalPages = 1;
private int totalCount = 0;
private string searchTerm = "";

@inject NavigationManager NavManager
@inject IARA.Web.Services.AuthService AuthService

private bool authChecked = false;
private bool isAuthenticated = false;

protected override async Task OnInitializedAsync()
{
    // Check authentication BEFORE rendering ANYTHING
    var token = await AuthService.GetTokenAsync();
    isAuthenticated = !string.IsNullOrEmpty(token) && !string.IsNullOrWhiteSpace(token);
    
    if (!isAuthenticated)
    {
        // NOT authenticated - redirect to login IMMEDIATELY
        authChecked = true;
        NavManager.NavigateTo("/login", forceLoad: true);
        return;
    }
    
    // Authenticated - allow rendering
    authChecked = true;
    await LoadShips();
}

private async Task LoadShips()
{
try
{
isLoading = true;
errorMessage = null;
var queryParams = new List<string> { $"page={currentPage}", "pageSize=20", "activeOnly=true" };
if (!string.IsNullOrEmpty(searchTerm))
{
queryParams.Add($"search={System.Uri.EscapeDataString(searchTerm)}");
}
var queryString = string.Join("&", queryParams);
var response = await Http.GetFromJsonAsync<ShipResponse>($"api/ShipRegistry?{queryString}");
if (response != null)
{
ships = response.Ships?.ToArray();
totalPages = response.TotalPages;
totalCount = response.TotalCount;
}
}
catch (Exception ex)
{
            if (ex.Message.Contains("Failed to fetch") || ex.Message.Contains("NetworkError"))
            {
                // Use mock data when API is not available
                await LoadMockShips();
                errorMessage = "⚠️ API сървърът не е достъпен. Показват се примерни данни.";
            }
            else
            {
                errorMessage = $"Грешка при зареждане: {ex.Message}";
            }
        }
finally
{
isLoading = false;
}
}

