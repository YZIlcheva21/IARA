                            <label class="form-label">ID на оператор</label>
                            <InputNumber @bind-Value="editShipModel.OperatorId" class="form-control" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEditShipModal">Отказ</button>
