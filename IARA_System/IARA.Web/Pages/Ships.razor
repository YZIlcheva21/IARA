@page "/ships"
@using System.Net.Http.Json
@using System.Linq
@using IARA.Web.Services
@inject AuthenticatedHttpClient Http
@inject IJSRuntime JS

@if (!authChecked)
{
    @* DO NOT RENDER ANYTHING until auth is checked *@
    <div style="display: none;"></div>
}
else if (!isAuthenticated)
{
    @* NOT AUTHENTICATED - redirect will happen *@
    <div style="display: none;"></div>
}
else
{
<div class="container-fluid p-4 page-container">
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="page-title mb-2">
                    <span class="page-icon">⛴</span>
                    Регистър на корабите
                </h1>
                <p class="page-subtitle text-muted mb-0">Управление на риболовни кораби и регистрация</p>
            </div>
            <button class="btn btn-primary rounded-pill px-4 btn-add-action" @onclick="ShowAddShipModal">
                <span class="oi oi-plus me-2"></span>Нов Кораб
            </button>
        </div>
    </div>

    <div class="mb-3">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Търсене по име, номер, позивна..." @bind="searchTerm" @bind:event="oninput" />
            <button class="btn btn-outline-primary" @onclick="OnSearch">Търси</button>
        </div>
    </div>

    @if (isLoading)
    {
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Зареждане на регистъра...</p>
    </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
    <div class="alert alert-danger">
        <strong>⚠️ Грешка при зареждане:</strong> @errorMessage
        <hr />
        <small>💡 <strong>Решение:</strong> Уверете се, че API сървърът работи на <code>http://localhost:5028</code></small>
    </div>
    }
    else if (ships == null || ships.Length == 0)
    {
    <div class="alert alert-info text-center">Няма намерени кораби</div>
    }
    else
    {
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var ship in ships)
        {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-light p-2 rounded text-primary">
                            <span class="oi oi-badge"></span>
                        </div>
                        <span class="badge bg-secondary">@ship.InternationalNumber</span>
                    </div>
                    <h5 class="card-title fw-bold">@ship.Name</h5>
                    <p class="card-text text-muted small mb-2">
                        <span class="oi oi-radio"></span> Позивна: @(ship.CallSign ?? "Няма")
                    </p>
                    @if (!string.IsNullOrEmpty(ship.ActiveLicenseNumber))
                    {
                    <p class="mb-2">
                        <span class="badge bg-success">Разрешително: @ship.ActiveLicenseNumber</span>
                    </p>
                    }
                    @if (!string.IsNullOrEmpty(ship.OwnerName))
                    {
                    <p class="text-muted small mb-2">Собственик: @ship.OwnerName</p>
                    }
                    <hr />
                    <div class="row text-center">
                        <div class="col border-end">
                            <div class="small text-muted">Дължина</div>
                            <div class="fw-bold">@(ship.Length?.ToString("F1") ?? "N/A") м</div>
                        </div>
                        <div class="col">
                            <div class="small text-muted">Мощност</div>
                            <div class="fw-bold">@(ship.EnginePower?.ToString("F0") ?? "N/A") kW</div>
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2 justify-content-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewShipDetails(ship.Id)" title="Преглед">
                            <span class="oi oi-eye"></span> Преглед
                        </button>
                        <button class="btn btn-sm btn-outline-warning" @onclick="() => EditShip(ship.Id)" title="Редактирай">
                            <span class="oi oi-pencil"></span> Редактирай
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteShip(ship.Id)" title="Изтрий кораб">
                            <span class="oi oi-trash"></span> Изтрий
                        </button>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
    
    @if (totalPages > 1)
    {
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="#" @onclick="() => ChangePage(currentPage - 1)" @onclick:preventDefault>Предишна</a>
            </li>
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link" href="#" @onclick="() => ChangePage(i)" @onclick:preventDefault>@i</a>
            </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="#" @onclick="() => ChangePage(currentPage + 1)" @onclick:preventDefault>Следваща</a>
            </li>
        </ul>
    </nav>
    }
    }
</div>
}

<!-- Modal за добавяне на нов кораб -->
@if (showAddShipModal)
{
<div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">
                    <span class="oi oi-plus me-2"></span>Добави нов кораб
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseAddShipModal"></button>
            </div>
            <div class="modal-body p-4">
                @if (!string.IsNullOrEmpty(addShipErrorMessage))
                {
                <div class="alert alert-danger">@addShipErrorMessage</div>
                }
                @if (!string.IsNullOrEmpty(addShipSuccessMessage))
                {
                <div class="alert alert-success">@addShipSuccessMessage</div>
                }
                
                <EditForm Model="@newShip" OnValidSubmit="HandleAddShip">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Име на кораба *</label>
                            <InputText @bind-Value="newShip.Name" class="form-control" placeholder="Напр. Посейдон" />
                            <ValidationMessage For="@(() => newShip.Name)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Международен номер (IMO) *</label>
                            <InputText @bind-Value="newShip.InternationalNumber" class="form-control" placeholder="Напр. IMO1234567" />
                            <ValidationMessage For="@(() => newShip.InternationalNumber)" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Позивна</label>
                            <InputText @bind-Value="newShip.CallSign" class="form-control" placeholder="Напр. LZ1234" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Маркировка</label>
                            <InputText @bind-Value="newShip.Marking" class="form-control" placeholder="Напр. PDN-001" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Регистрационен номер</label>
                            <InputText @bind-Value="newShip.RegistrationNumber" class="form-control" placeholder="Напр. BG-001" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Домашен пристан</label>
                            <InputText @bind-Value="newShip.HomePort" class="form-control" placeholder="Напр. Варна" />
                        </div>
                    </div>
                    
                    <hr class="my-3" />
                    <h6 class="fw-bold mb-3">Технически параметри</h6>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Дължина (м)</label>
                            <InputNumber @bind-Value="newShip.Length" class="form-control" placeholder="0.0" min="0.1" step="0.1" />
                            <small class="text-muted">Минимум: 0.1 м</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Ширина (м)</label>
                            <InputNumber @bind-Value="newShip.Width" class="form-control" placeholder="0.0" min="0.1" step="0.1" />
                            <small class="text-muted">Минимум: 0.1 м</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Мощност (kW)</label>
                            <InputNumber @bind-Value="newShip.EnginePower" class="form-control" placeholder="0" min="1" step="1" />
                            <small class="text-muted">Минимум: 1 kW</small>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Тип двигател</label>
                            <InputSelect @bind-Value="newShip.EngineType" class="form-select">
                                <option value="">Изберете...</option>
                                <option value="Diesel">Diesel</option>
                                <option value="Gasoline">Gasoline</option>
                                <option value="Electric">Electric</option>
                                <option value="Hybrid">Hybrid</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Вид гориво</label>
                            <InputSelect @bind-Value="newShip.FuelType" class="form-select">
                                <option value="">Изберете...</option>
                                <option value="Diesel">Diesel</option>
                                <option value="Gasoline">Gasoline</option>
                                <option value="LPG">LPG</option>
                                <option value="CNG">CNG</option>
                            </InputSelect>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Среден разход (л/час)</label>
                            <InputNumber @bind-Value="newShip.AverageFuelConsumptionPerHour" class="form-control" placeholder="0.0" min="0.1" step="0.1" />
                            <small class="text-muted">Минимум: 0.1 л/час</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Година на построяване</label>
                            <InputNumber @bind-Value="builtYearValue" class="form-control" placeholder="Напр. 2020" min="1900" max="@(DateTime.Now.Year + 1)" />
                            <small class="text-muted">Година между 1900 и @(DateTime.Now.Year + 1)</small>
                        </div>
                    </div>
                    
                    <hr class="my-3" />
                    <h6 class="fw-bold mb-3">Собственост и управление</h6>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">ID на собственик</label>
                            <InputNumber @bind-Value="newShip.OwnerId" class="form-control" placeholder="Опционално" />
                            <small class="text-muted">Въведете ID на рибар от базата данни</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">ID на капитан</label>
                            <InputNumber @bind-Value="newShip.CaptainId" class="form-control" placeholder="Опционално" />
                            <small class="text-muted">Въведете ID на рибар от базата данни</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">ID на оператор</label>
                            <InputNumber @bind-Value="newShip.OperatorId" class="form-control" placeholder="Опционално" />
                            <small class="text-muted">Въведете ID на рибар от базата данни</small>
                        </div>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseAddShipModal">Отказ</button>
                        <button type="submit" class="btn btn-primary" disabled="@isAddingShip">
                            @if (isAddingShip)
                            {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <span class="oi oi-check me-2"></span>Запази
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
}

<!-- Modal за преглед на кораб -->
@if (showViewShipModal && currentShip != null)
{
<div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title fw-bold">
                    <span class="oi oi-eye me-2"></span>Детайли на кораб
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseViewShipModal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <strong>Име:</strong> @currentShip.Name
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Международен номер:</strong> @currentShip.InternationalNumber
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Позивна:</strong> @(currentShip.CallSign ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Маркировка:</strong> @(currentShip.Marking ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Регистрационен номер:</strong> @(currentShip.RegistrationNumber ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Домашно пристанище:</strong> @(currentShip.HomePort ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Дължина:</strong> @(currentShip.Length?.ToString("F1") ?? "N/A") м
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Ширина:</strong> @(currentShip.Width?.ToString("F1") ?? "N/A") м
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Бруто тонаж:</strong> @(currentShip.GrossTonnage?.ToString("F1") ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Газене:</strong> @(currentShip.Draught?.ToString("F1") ?? "N/A") м
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Мощност на двигател:</strong> @(currentShip.EnginePower?.ToString("F0") ?? "N/A") kW
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Тип двигател:</strong> @(currentShip.EngineType ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Вид гориво:</strong> @(currentShip.FuelType ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Среден разход:</strong> @(currentShip.AverageFuelConsumptionPerHour?.ToString("F2") ?? "N/A") л/час
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Година на построяване:</strong> @(currentShip.BuiltYear?.Year.ToString() ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Статус:</strong> 
                        <span class="badge bg-@(currentShip.IsActive ? "success" : "danger")">
                            @(currentShip.IsActive ? "Активен" : "Неактивен")
                        </span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Голям кораб (>12м):</strong> @(currentShip.IsLargeShip ? "Да" : "Не")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Собственик:</strong> @(currentShip.OwnerName ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Капитан:</strong> @(currentShip.CaptainName ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Оператор:</strong> @(currentShip.OperatorName ?? "N/A")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Активно разрешително:</strong> @(currentShip.ActiveLicenseNumber ?? "Няма")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Брой разрешителни:</strong> @(currentShip.LicenseCount ?? 0)
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Брой дневници:</strong> @(currentShip.LogbookEntryCount ?? 0)
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Брой инспекции:</strong> @(currentShip.InspectionCount ?? 0)
                    </div>
                    <div class="col-12 mb-3">
                        <strong>Създаден на:</strong> @currentShip.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseViewShipModal">Затвори</button>
                <button type="button" class="btn btn-warning" @onclick="async () => { CloseViewShipModal(); await EditShip(currentShip.Id); }">Редактирай</button>
            </div>
        </div>
    </div>
</div>
}

<!-- Modal за редактиране на кораб -->
