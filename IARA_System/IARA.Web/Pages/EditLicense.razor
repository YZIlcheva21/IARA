@page "/licenses/edit/{Id:int}"
@using System.Net.Http.Json
@using IARA.Web.Services
@inject AuthenticatedHttpClient Http
@inject NavigationManager NavManager
@inject AuthService AuthService
@inject IJSRuntime JS

<PageTitle>Редакция на разрешително</PageTitle>

<div class="container p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <span class="oi oi-pencil me-2"></span>Редакция на разрешително
        </h1>
        <button class="btn btn-outline-secondary" @onclick="GoBack">
            <span class="oi oi-arrow-left me-2"></span>Назад
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Зареждане на данните...</p>
        </div>
    }
    else if (loadError)
    {
        <div class="alert alert-danger">
            Грешка при зареждане на разрешителното. Вероятно записът не съществува или няма връзка със сървъра.
            <div class="mt-2">
                <button class="btn btn-danger btn-sm" @onclick="GoBack">Върни се назад</button>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <EditForm Model="@licenseModel" OnValidSubmit="HandleUpdate">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Номер на разрешителното *</label>
                            <InputText @bind-Value="licenseModel.LicenseNumber" class="form-control" />
                            <ValidationMessage For="@(() => licenseModel.LicenseNumber)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">ID на рибар *</label>
                            <InputNumber @bind-Value="licenseModel.FisherId" class="form-control" />
                            <ValidationMessage For="@(() => licenseModel.FisherId)" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ID на кораб</label>
                            <InputNumber @bind-Value="licenseModel.ShipId" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Тип разрешително</label>
                            <InputSelect @bind-Value="licenseModel.LicenseType" class="form-select">
                                <option value="">Изберете...</option>
                                <option value="Професионален риболов">Професионален риболов</option>
                                <option value="Любителски риболов">Любителски риболов</option>
                                <option value="Спортен риболов">Спортен риболов</option>
                                <option value="Търговски риболов">Търговски риболов</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Дата на издаване</label>
                            <InputDate @bind-Value="licenseModel.IssueDate" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Дата на изтичане</label>
                            <InputDate @bind-Value="licenseModel.ExpiryDate" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Статус</label>
                            <InputSelect @bind-Value="licenseModel.Status" class="form-select">
                                <option value="Active">Активно</option>
                                <option value="Expired">Изтекло</option>
                                <option value="Revoked">Отнето</option>
                                <option value="Suspended">Суспендирано</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Издаващ орган</label>
                            <InputText @bind-Value="licenseModel.IssuingAuthority" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Бележки</label>
                        <InputTextArea @bind-Value="licenseModel.Notes" class="form-control" rows="3" />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" @onclick="GoBack">Отказ</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Запази промените
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateLicenseModel licenseModel = new();
    private bool isLoading = true;
    private bool loadError = false;
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await AuthService.GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                NavManager.NavigateTo("/login");
                return;
            }

            // Опитваме да заредим данните от API
            var response = await Http.GetFromJsonAsync<UpdateLicenseModel>($"api/Licenses/{Id}");
            if (response != null)
            {
                licenseModel = response;
            }
            else
            {
                loadError = true;
            }
        }
        catch (Exception)
        {
            // Ако API-то не работи, ползваме примерни данни за тест (MOCK)
            // Това е само за да видиш, че страницата работи визуално
            loadError = false; 
            licenseModel = new UpdateLicenseModel
            {
                LicenseNumber = "MOCK-DATA-ERROR",
                FisherId = 1,
                IssueDate = DateTime.Now,
                Status = "Active",
                Notes = "Данните не можаха да се заредят от сървъра."
            };
             await JS.InvokeVoidAsync("console.log", "Грешка при GET заявка. Заредени са тестови данни.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            // Изпращаме PUT заявка за обновяване
            var response = await Http.PutAsJsonAsync($"api/Licenses/{Id}", licenseModel);

            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Промените са запазени успешно!");
                NavManager.NavigateTo("/licenses");
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                errorMessage = $"Грешка при запис: {response.StatusCode}. {errorMsg}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Грешка: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/licenses");
    }

    public class UpdateLicenseModel
    {
        public string LicenseNumber { get; set; } = "";
        public int? FisherId { get; set; }
        public int? ShipId { get; set; }
        public DateTime? IssueDate { get; set; }
        public DateTime? ExpiryDate { get; set; }
        public string? Status { get; set; }
        public string? LicenseType { get; set; }
        public string? IssuingAuthority { get; set; }
        public string? Notes { get; set; }
    }
}